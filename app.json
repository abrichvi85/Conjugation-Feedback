{
  "expo": {
    "name": "Conjugation Feedback",
    "slug": "conjugation-feedback",
    "version": "0.1.0",
    "scheme": "conjugationfeedback",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.abrich.conjugationfeedback",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Conjugation Feedback listens to your speech during practice sessions to detect grammar mistakes and give you corrections.",
        "UIBackgroundModes": ["audio"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.abrich.conjugationfeedback",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "@siteed/audio-studio",
        {
          "enableBackgroundAudio": true,
          "enableNotifications": true,
          "enableDeviceDetection": true,
          "enablePhoneStateHandling": true,
          "iosBackgroundModes": {
            "useAudio": true,
            "useProcessing": true
          },
          "iosConfig": {
            "microphoneUsageDescription": "Conjugation Feedback listens to your speech during practice sessions to detect grammar mistakes and give you corrections."
          }
        }
      ]
    ]
  }
}
